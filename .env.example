# Local Docker Compose
DB_HOST=db
DB_NAME=indexhibit
DB_USER=indexhibit
DB_PASS=indexhibit
DB_PREFIX=ndxz_

# Fly.io production (use `fly secrets set` for secrets)
# DB_HOST=indexhibit-db.flycast
# DB_NAME=indexhibit
# DB_USER=indexhibit
# DB_PASS=...

PUBLIC_URL=https://example.com
TRUSTED_PROXIES=*
AUTO_INSTALL=1
# Set to 1 only if you intentionally want the legacy browser installer
# reachable at /ndxzstudio/install.php. It is disabled by default.
# ALLOW_WEB_INSTALL=1
SITE_NAME=example.com
ADMIN_EMAIL=admin@example.com
ADMIN_FNAME=Admin
ADMIN_LNAME=Admin

# Bunny.net purge API
BUNNY_API_KEY=
BUNNY_PULL_ZONE_ID=
